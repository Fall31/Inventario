      "name": "01 - Categorias (E2E)",
      "description": "Flujo E2E completo sobre /api/v1/categories: alta, consulta, actualizacion, casos negativos y baja.",
      "item": [
        {
          "name": "1.1 Crear categoria (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test('La categoria se creo correctamente', function () {",
                  "    pm.expect(jsonData.categoryResponse.category).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(jsonData.categoryResponse.category[0].name).to.eql('Electronica E2E');",
                  "});",
                  "",
                  "pm.test('El metadata indica respuesta exitosa', function () {",
                  "    pm.expect(jsonData.metadata[0].code).to.eql('00');",
                  "});",
                  "",
                  "// Encadenamos el id creado para los siguientes requests del flujo E2E",
                  "pm.collectionVariables.set('categoryId', jsonData.categoryResponse.category[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories"
              ]
            },
            "description": "Crea una categoria nueva y guarda su id en la variable de coleccion {{categoryId}} para reutilizarla en el resto del flujo.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Electronica E2E\",\n    \"description\": \"Categoria creada por prueba E2E de Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "1.2 Listar categorias (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "const categoryId = parseInt(pm.collectionVariables.get('categoryId'));",
                  "",
                  "pm.test('El listado contiene la categoria creada en el paso anterior', function () {",
                  "    const ids = jsonData.categoryResponse.category.map(c => c.id);",
                  "    pm.expect(ids).to.include(categoryId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories",
              "host": [
                "{{baseUrl}}"
